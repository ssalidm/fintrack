# ==========================================
# Docker Compose
# ==========================================
COMPOSE_PROJECT_NAME=fintrack

# ==========================================
# PostgreSQL bootstrap configuration
# ==========================================
POSTGRES_DB=fintrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_local_password

# Host port mapped to PostgreSQL container port 5432
POSTGRES_PORT=5433

FINTRACK_DB_URL=jdbc:postgresql://localhost:5433/fintrack_db

# ==========================================
# Database migration role
# ==========================================
FINTRACK_MIGRATION_USER=fintrack_migration
FINTRACK_MIGRATION_PASSWORD=replace_with_a_secure_migration_password

# ==========================================
# Spring Boot application role
# ==========================================
FINTRACK_APPLICATION_USER=fintrack_application
FINTRACK_APPLICATION_PASSWORD=replace_with_a_secure_application_password

# ==========================================
# Spring Boot
# ==========================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ==========================================
# Frontend
# ==========================================
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# JWT
# ==========================================
FINTRACK_JWT_SECRET=replace-with-a-secure-base64-secret

FINTRACK_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# Local email testing
# ==========================================
FINTRACK_EMAIL_ENABLED=true
FINTRACK_MAIL_HOST=localhost
FINTRACK_MAIL_PORT=1025
FINTRACK_MAIL_SMTP_AUTH=false
FINTRACK_MAIL_STARTTLS=false
FINTRACK_EMAIL_FROM=no-reply@salif.local
FINTRACK_EMAIL_FROM_NAME=Salif
FINTRACK_FRONTEND_BASE_URL=http://localhost:5173
