# Public browser configuration — never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Public, monitored support mailbox.
# Configure in .env.local for development and the build environment for deployment.
# Leaving this blank disables the email contact option.
VITE_SUPPORT_EMAIL=

# Public Cloudflare Turnstile site key.
# Configure in .env.local and the frontend deployment build environment.
# The matching secret key belongs only in backend configuration.
VITE_TURNSTILE_SITE_KEY=